 "graphql_product_slug": {
  "id": "graphql_product_slug",
  "description": "JS-rendered product pages whose inline config holds a GraphQL endpoint ('api') and product(slug) query; fetch via POST with slug = last path segment.",
  "detector": {
   "html_regex": "\"api\":\\s*\"[^\"]*graphql\"[\\s\\S]*product\\(slug:\\$slug\\)",
   "request_url_regex": "/graphql"
  },
  "recipe": {
   "tier": "T0",
   "steps": [
    {
     "name": "page",
     "method": "GET",
     "url": "{{page_url}}",
     "parse": "text",
     "extract": {
      "api": {
       "regex": "\"api\":\\s*\"([^\"]+)\"",
       "first": true
      },
      "query": {
       "regex": "\"query\":\\s*\"(query Item[^\"]+)\"",
       "first": true
      }
     }
    },
    {
     "name": "data",
     "method": "POST",
     "url": "{{origin}}{{api}}",
     "headers": {
      "Content-Type": "application/json"
     },
     "body": "{\"query\":\"{{query}}\",\"variables\":{\"slug\":\"{{last}}\"}}",
     "parse": "json"
    }
   ],
   "output": {
    "title": {
     "step": "data",
     "path": "data.product.name",
     "first": true
    },
    "main_text": [
     {
      "step": "data",
      "path": "data.product.name"
     },
     {
      "step": "data",
      "path": "data.product.description",
      "split": "\\n+"
     },
     {
      "step": "data",
      "path": "data.product.attributes",
      "kv": {
       "key": "key",
       "value": "value"
      }
     }
    ],
    "links": [
     {
      "step": "data",
      "path": "data.product.related[*]",
      "template": "{{origin}}/products/{{slug}}"
     }
    ]
   }
  },
  "source_episode": "28dc9de8b3",
  "state": "active",
  "stats": {
   "tried": 0,
   "won": 0
  },
  "created": 1794929895.2543933
 },
