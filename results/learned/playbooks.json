 "api_v1_items_csrf_spa": {
  "id": "api_v1_items_csrf_spa",
  "description": "SPA item pages that render via fetch to {api}/items/{id} with optional X-CSRF-Token from meta csrf-token",
  "detector": {
   "html_regex": "\"api\":\\s*\"/api/v1\"[\\s\\S]*X-CSRF-Token"
  },
  "recipe": {
   "id": "api_v1_items_csrf_spa",
   "pattern_id": "playbook",
   "tier": "T0",
   "origin": "playbook:api_v1_items_csrf_spa",
   "steps": [
    {
     "name": "page",
     "method": "GET",
     "url": "{{page_url}}",
     "parse": "html",
     "extract": {
      "csrf": {
       "regex": "<head>(?:[\\s\\S]*?name=\"csrf-token\" content=\"([^\"]*)\")?",
       "first": true
      }
     }
    },
    {
     "name": "api",
     "method": "GET",
     "url": "{{origin}}/api/v1/items/{{last}}",
     "headers": {
      "Accept": "application/json",
      "X-CSRF-Token": "{{csrf}}",
      "Referer": "{{page_url}}"
     },
     "parse": "json"
    }
   ],
   "output": {
    "title": {
     "step": "api",
     "path": "item.title"
    },
    "main_text": [
     {
      "step": "api",
      "path": "item.title"
     },
     {
      "step": "api",
      "path": "item.paragraphs[*]"
     },
     {
      "step": "api",
      "path": "item",
      "template": "price: {{price}}\nsku: {{sku}}\ncategory: {{category}}\nrating: {{rating}}"
     }
    ],
    "links": [
     {
      "step": "api",
      "path": "item.related[*]",
      "template": "{{origin}}/item/{{id}}"
     }
    ]
   }
  },
  "source_episode": "1dfa690c7f",
  "state": "active",
  "stats": {
   "tried": 0,
   "won": 0
  },
  "created": 1794929909.5862014
 }
